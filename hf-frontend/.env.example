# ============================================
# 백엔드 환경 변수 템플릿
# ============================================

# 데이터베이스
DB_NAME=local_deep_trend.db

# Ollama AI 모델
OLLAMA_MODEL=qwen3.5:9b

# 수집 작업
BATCH_SIZE=5
MAX_RETRIES=3
COLLECTION_INTERVAL_HOURS=3

# API 서버
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# 로깅
LOG_LEVEL=INFO
# LOG_FILE=app.log

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# 크롤링
CRAWL_TIMEOUT=30
CRAWL_MAX_CONCURRENT=5

# RSS
RSS_FETCH_TIMEOUT=10
RSS_MAX_ENTRIES=2

# 번역
TRANSLATION_TEMPERATURE=0.1
TRANSLATION_MAX_TOKENS=2048
TRANSLATION_CONTEXT_WINDOW=4096

# ============================================
# 프론트엔드 환경 변수 템플릿 (Vite)
# ============================================

# API URL
VITE_API_URL=http://localhost:8000

# 앱 정보
VITE_APP_NAME=Local Trend & Deep Content Inspector
VITE_APP_VERSION=1.0.0

# 디버그
VITE_DEBUG_MODE=true

# 시스템 모니터링
VITE_SYSTEM_POLLING_INTERVAL=2000

# 번역
VITE_TRANSLATION_RETRY_MAX=3
VITE_TRANSLATION_RETRY_DELAY=2000
VITE_TRANSLATION_CHUNK_THRESHOLD=50

# UI
VITE_DEFAULT_THEME=dark
VITE_TOAST_DURATION=3000